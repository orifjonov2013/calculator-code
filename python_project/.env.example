# Environment Variables Configuration
# Django Backend Settings
DJANGO_SECRET_KEY=django-insecure-omnimath-ai-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# DRF Calculator API URL (used by the Aiogram 3 bot to query the backend)
CALCULATOR_API_URL=http://localhost:8000/api/v1/calculate/
OCR_API_URL=http://localhost:8000/api/v1/ocr/

# Google Gemini API Key for OCR & Step Reasoning
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
